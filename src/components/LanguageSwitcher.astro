---
import { defaultLang, type Lang } from "../i18n/translations";

interface Props {
  currentLang: Lang;
}

const { currentLang } = Astro.props;
---

<div
  class="lang-switcher inline-flex items-center rounded-full border border-white/20 bg-white/10 p-0.5 text-xs font-semibold tracking-wide"
  data-current-lang={currentLang}
  data-default-lang={defaultLang}
  role="group"
  aria-label="Language"
>
  <a
    href="/"
    data-lang-code="pl"
    class:list={[
      "lang-option min-w-[2.25rem] rounded-full px-2.5 py-1.5 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-400",
      currentLang === "pl"
        ? "bg-white text-ink-900 shadow-sm"
        : "text-white/70 hover:text-white",
    ]}
    aria-current={currentLang === "pl" ? "true" : undefined}
  >
    PL
  </a>
  <a
    href="/en/"
    data-lang-code="en"
    class:list={[
      "lang-option min-w-[2.25rem] rounded-full px-2.5 py-1.5 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-400",
      currentLang === "en"
        ? "bg-white text-ink-900 shadow-sm"
        : "text-white/70 hover:text-white",
    ]}
    aria-current={currentLang === "en" ? "true" : undefined}
  >
    EN
  </a>
</div>

<script>
  // Polish (default) has NO prefix:  /   /services   /work
  // English has a prefix:           /en/  /en/services
  function buildLangUrl(targetLang: string, defaultLang: string): string {
    const allLangs = ["pl", "en"];
    const pathname = window.location.pathname;
    const segments = pathname.split("/").filter(Boolean);
    const pageParts = allLangs.includes(segments[0]) ? segments.slice(1) : segments;

    if (targetLang === defaultLang) {
      return pageParts.length === 0 ? "/" : "/" + pageParts.join("/");
    }
    return pageParts.length === 0
      ? `/${targetLang}/`
      : `/${targetLang}/${pageParts.join("/")}`;
  }

  document.querySelectorAll(".lang-switcher").forEach((switcher) => {
    const defaultLang = (switcher as HTMLElement).dataset.defaultLang ?? "pl";
    switcher.querySelectorAll<HTMLAnchorElement>(".lang-option").forEach((a) => {
      const code = a.dataset.langCode ?? "";
      a.href = buildLangUrl(code, defaultLang);
    });
  });
</script>
